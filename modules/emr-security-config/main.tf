terraform {
  required_version = ">= 1.3"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

# IAM is identical to the other cluster variants. Encryption doesn't change how
# the cluster authenticates to AWS — it changes how data is protected at rest
# and in flight — so the role boilerplate is the same.
data "aws_iam_policy_document" "ec2_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

data "aws_iam_policy_document" "emr_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["elasticmapreduce.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "emr_service" {
  name               = "${var.name}-emr-service"
  assume_role_policy = data.aws_iam_policy_document.emr_assume.json
}

resource "aws_iam_role_policy_attachment" "emr_service" {
  role       = aws_iam_role.emr_service.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonEMRServicePolicy_v2"
}

resource "aws_iam_role" "emr_ec2" {
  name               = "${var.name}-emr-ec2"
  assume_role_policy = data.aws_iam_policy_document.ec2_assume.json
}

resource "aws_iam_role_policy_attachment" "emr_ec2" {
  role       = aws_iam_role.emr_ec2.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonElasticMapReduceforEC2Role"
}

resource "aws_iam_instance_profile" "emr_ec2" {
  name = "${var.name}-emr-ec2"
  role = aws_iam_role.emr_ec2.name
}

# --- The point of this variant: a customer-managed key + a security
# configuration that wires encryption into the cluster ---------------------

data "aws_caller_identity" "current" {}

# Encryption needs a key. We provision a customer-managed KMS key so the POC is
# self-contained — no pre-existing key to point at. The key policy is the part
# people get wrong: KMS access is deny-by-default, so the two EMR roles must be
# named explicitly or the cluster fails to launch with opaque KMS errors.
data "aws_iam_policy_document" "kms" {
  # Account root keeps full control so the key stays manageable (and so IAM
  # policies in this account can delegate access to it later if needed).
  statement {
    sid       = "EnableRootAccount"
    actions   = ["kms:*"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = ["arn:aws:iam::${data.aws_caller_identity.current.account_id}:root"]
    }
  }

  # EMRFS (S3 SSE-KMS) runs under the EC2 instance profile; the EMR service role
  # touches the key while provisioning. Both need to use it directly.
  statement {
    sid = "AllowEmrRolesUseOfKey"
    actions = [
      "kms:Encrypt",
      "kms:Decrypt",
      "kms:ReEncrypt*",
      "kms:GenerateDataKey*",
      "kms:DescribeKey",
    ]
    resources = ["*"]
    principals {
      type = "AWS"
      identifiers = [
        aws_iam_role.emr_ec2.arn,
        aws_iam_role.emr_service.arn,
      ]
    }
  }

  # Local-disk (EBS) encryption is grant-based: EMR hands the volumes to EC2,
  # which needs CreateGrant to encrypt/decrypt them on the cluster's behalf.
  # The GrantIsForAWSResource condition is what the AWS console emits for the
  # "key users" it adds — scoping the grant to AWS service integrations only.
  statement {
    sid = "AllowEmrRolesGrantsForEbs"
    actions = [
      "kms:CreateGrant",
      "kms:ListGrants",
      "kms:RevokeGrant",
    ]
    resources = ["*"]
    principals {
      type = "AWS"
      identifiers = [
        aws_iam_role.emr_ec2.arn,
        aws_iam_role.emr_service.arn,
      ]
    }
    condition {
      test     = "Bool"
      variable = "kms:GrantIsForAWSResource"
      values   = ["true"]
    }
  }
}

resource "aws_kms_key" "emr" {
  description             = "${var.name} EMR at-rest encryption"
  deletion_window_in_days = 7
  enable_key_rotation     = true
  policy                  = data.aws_iam_policy_document.kms.json
}

resource "aws_kms_alias" "emr" {
  name          = "alias/${var.name}-emr"
  target_key_id = aws_kms_key.emr.key_id
}

locals {
  # The security configuration is a single JSON document. At-rest encryption is
  # always on here (the whole point); in-transit is opt-in because TLS requires
  # you to supply certificates, which can't be auto-generated by Terraform.
  #
  # The merge() grafts the in-transit block in as a sibling of the at-rest
  # block only when enabled — both live directly under EncryptionConfiguration,
  # so a shallow merge is correct.
  encryption_configuration = merge(
    {
      EnableAtRestEncryption    = true
      EnableInTransitEncryption = var.enable_in_transit

      AtRestEncryptionConfiguration = {
        # EMRFS reads/writes to S3 with server-side KMS encryption.
        S3EncryptionConfiguration = {
          EncryptionMode = "SSE-KMS"
          AwsKmsKey      = aws_kms_key.emr.arn
        }
        # Spill/shuffle/HDFS on the instance volumes, plus the EBS volumes
        # themselves, are encrypted with the same key.
        LocalDiskEncryptionConfiguration = {
          EncryptionKeyProviderType = "AwsKms"
          AwsKmsKey                 = aws_kms_key.emr.arn
          EnableEbsEncryption       = true
        }
      }
    },
    var.enable_in_transit ? {
      # In-transit (node-to-node TLS) needs a certificate bundle. PEM mode
      # expects a zip in S3 containing privateKey.pem + certificateChain.pem;
      # the alternative is a custom Java certificate-provider class.
      InTransitEncryptionConfiguration = {
        TLSCertificateConfiguration = {
          CertificateProviderType = "PEM"
          S3Object                = var.tls_certificate_s3_uri
        }
      }
    } : {},
  )
}

# Security configurations are immutable in EMR and can't be deleted while a
# cluster references them. name_prefix lets Terraform create a replacement
# under a fresh name before retiring the old one when the config changes.
resource "aws_emr_security_configuration" "this" {
  name_prefix   = "${var.name}-"
  configuration = jsonencode({ EncryptionConfiguration = local.encryption_configuration })

  lifecycle {
    create_before_destroy = true

    precondition {
      condition     = !var.enable_in_transit || var.tls_certificate_s3_uri != ""
      error_message = "enable_in_transit = true requires tls_certificate_s3_uri to point at a PEM bundle zip in S3."
    }
  }
}

resource "aws_emr_cluster" "this" {
  name          = var.name
  release_label = var.release_label
  applications  = var.applications

  service_role         = aws_iam_role.emr_service.arn
  log_uri              = var.log_uri
  ebs_root_volume_size = 20

  # Attaching the security configuration is the one line that turns encryption
  # on for this cluster. Changing it later forces a new cluster — EMR can't
  # re-encrypt a running cluster in place.
  security_configuration = aws_emr_security_configuration.this.name

  ec2_attributes {
    subnet_id        = var.subnet_id
    instance_profile = aws_iam_instance_profile.emr_ec2.arn
  }

  master_instance_group {
    instance_type  = var.master_instance_type
    instance_count = 1
  }

  core_instance_group {
    instance_type  = var.core_instance_type
    instance_count = var.core_instance_count
  }

  keep_job_flow_alive_when_no_steps = true
  visible_to_all_users              = true
}
